{
  "expo": {
    "name": "Mock Store",
    "slug": "itfits-mock-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mockstore",
    "userInterfaceStyle": "light",
    "ios": { "supportsTablet": true },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/favicon.png" },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
